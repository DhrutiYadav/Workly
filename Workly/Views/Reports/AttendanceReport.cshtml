@model IEnumerable<Workly.Models.Attendance>

@{
    ViewData["Title"] = "Attendance Report";
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Page Header -->
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                Attendance Report
            </h1>

            <p class="mt-2 text-sm text-gray-600">
                View and filter employee attendance records.
            </p>
        </div>

        <a asp-controller="Reports"
           asp-action="Index"
           class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
            Back to Reports
        </a>
    </div>

    <!-- Filters -->
    <div class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

        <h2 class="mb-5 text-lg font-semibold text-gray-900">
            Filter Attendance
        </h2>

        <form asp-controller="Reports"
              asp-action="AttendanceReport"
              method="get"
              class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">

            <div>
                <label for="employeeId"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    Employee
                </label>

                <select id="employeeId"
                        name="employeeId"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm">

                    <option value="">All Employees</option>

                    @foreach (var employee in ViewBag.Employees)
                    {
                        if (ViewBag.SelectedEmployeeId != null &&
                            (int)ViewBag.SelectedEmployeeId == employee.Id)
                        {
                            <option value="@employee.Id" selected>
                                @employee.FullName
                            </option>
                        }
                        else
                        {
                            <option value="@employee.Id">
                                @employee.FullName
                            </option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="startDate"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    Start Date
                </label>

                <input type="date"
                       id="startDate"
                       name="startDate"
                       value="@ViewBag.StartDate"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm" />
            </div>

            <div>
                <label for="endDate"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    End Date
                </label>

                <input type="date"
                       id="endDate"
                       name="endDate"
                       value="@ViewBag.EndDate"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm" />
            </div>

            <div>
                <label for="status"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    Attendance Status
                </label>

                <select id="status"
                        name="status"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm">

                    <option value="">All Statuses</option>

                    @foreach (AttendanceStatus attendanceStatus in
                        Enum.GetValues(typeof(AttendanceStatus)))
                    {
                        if (ViewBag.SelectedStatus == attendanceStatus.ToString())
                        {
                            <option value="@attendanceStatus" selected>
                                @(attendanceStatus == AttendanceStatus.HalfDay
                                    ? "Half Day"
                                    : attendanceStatus.ToString())
                            </option>
                        }
                        else
                        {
                            <option value="@attendanceStatus">
                                @(attendanceStatus == AttendanceStatus.HalfDay
                                    ? "Half Day"
                                    : attendanceStatus.ToString())
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="flex flex-wrap items-end gap-3 sm:col-span-2 lg:col-span-4">

                <button type="submit"
                        class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                    Apply Filters
                </button>

                <a asp-controller="Reports"
                   asp-action="AttendanceReport"
                   class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                    Clear Filters
                </a>

            </div>

        </form>
    </div>

    <!-- Summary Cards -->
    <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5">

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">Total Records</p>
            <h2 class="mt-3 text-3xl font-bold text-gray-900">
                @ViewBag.TotalRecords
            </h2>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-green-700">Present</p>
            <h2 class="mt-3 text-3xl font-bold text-green-600">
                @ViewBag.PresentCount
            </h2>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-red-700">Absent</p>
            <h2 class="mt-3 text-3xl font-bold text-red-600">
                @ViewBag.AbsentCount
            </h2>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-yellow-700">Half Day</p>
            <h2 class="mt-3 text-3xl font-bold text-yellow-600">
                @ViewBag.HalfDayCount
            </h2>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-blue-700">Leave</p>
            <h2 class="mt-3 text-3xl font-bold text-blue-600">
                @ViewBag.LeaveCount
            </h2>
        </div>

    </div>

    <!-- Attendance Status Chart -->
    <div class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

        <h2 class="mb-2 text-lg font-semibold text-gray-900">
            Attendance Status Overview
        </h2>

        <p class="mb-5 text-sm text-gray-600">
            Distribution of attendance statuses for the selected filters.
        </p>

        <div class="mx-auto" style="max-width: 420px;">
            <canvas id="attendanceStatusChart"></canvas>
        </div>

    </div>

    <!-- Attendance Table -->
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

        <div class="border-b border-gray-200 px-6 py-5">
            <h2 class="text-lg font-semibold text-gray-900">
                Attendance Records
            </h2>

            <p class="mt-1 text-sm text-gray-500">
                Showing @Model.Count() attendance record(s).
            </p>
        </div>

        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">

                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Employee
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Department
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Attendance Date
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Status
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Notes
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">

                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                AttendanceStatus.Present =>
                                    "bg-green-100 text-green-800",

                                AttendanceStatus.Absent =>
                                    "bg-red-100 text-red-800",

                                AttendanceStatus.HalfDay =>
                                    "bg-yellow-100 text-yellow-800",

                                AttendanceStatus.Leave =>
                                    "bg-blue-100 text-blue-800",

                                _ => "bg-gray-100 text-gray-800"
                            };

                            <tr class="transition hover:bg-gray-50">

                                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                                    @(item.Employee?.FullName ?? "Unknown")
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">
                                    @(item.Employee?.Department ?? "—")
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">
                                    @item.AttendanceDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @statusClass">
                                        @(item.Status == AttendanceStatus.HalfDay
                                            ? "Half Day"
                                            : item.Status.ToString())
                                    </span>
                                </td>

                                <td class="max-w-xs px-6 py-4 text-sm text-gray-600">
                                    @(string.IsNullOrWhiteSpace(item.Notes)
                                        ? "—"
                                        : item.Notes)
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <a asp-controller="Attendance"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="inline-flex rounded-lg bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">
                                        Details
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-6 py-16 text-center">

                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-2xl">
                    📅
                </div>

                <h3 class="mt-4 text-lg font-semibold text-gray-900">
                    No Attendance Records Found
                </h3>

                <p class="mt-2 text-sm text-gray-500">
                    Try changing or clearing your filters.
                </p>

            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const attendanceStatusData = {
            present: @Model.Count(a => a.Status == Workly.Models.AttendanceStatus.Present),
            absent: @Model.Count(a => a.Status == Workly.Models.AttendanceStatus.Absent),
            halfDay: @Model.Count(a => a.Status == Workly.Models.AttendanceStatus.HalfDay),
            leave: @Model.Count(a => a.Status == Workly.Models.AttendanceStatus.Leave)
        };

        const chartCanvas = document.getElementById('attendanceStatusChart');

        if (chartCanvas) {
            new Chart(chartCanvas, {
                type: 'doughnut',

                data: {
                    labels: ['Present', 'Absent', 'Half Day', 'Leave'],

                    datasets: [{
                        data: [
                            attendanceStatusData.present,
                            attendanceStatusData.absent,
                            attendanceStatusData.halfDay,
                            attendanceStatusData.leave
                        ],
                        backgroundColor: [
                            '#16a34a',
                            '#dc2626',
                            '#eab308',
                            '#2563eb'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: true,

                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }
    </script>
}