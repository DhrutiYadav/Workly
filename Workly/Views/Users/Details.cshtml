@model Workly.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="min-h-screen bg-gray-50 py-8">

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

        <!-- Page Header -->
        <div class="mb-6">

            <a asp-action="Index"
               class="mb-3 inline-flex items-center gap-2 text-sm font-medium text-gray-500 no-underline transition hover:text-blue-600">

                <span>←</span>
                Back to Users

            </a>

            <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                User Details
            </h1>

            <p class="mt-1 text-sm text-gray-500">
                View employee information
            </p>

        </div>


        <!-- User Card -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <!-- Profile Header -->
            <div class="border-b border-gray-100 bg-gray-50 px-6 py-6 sm:px-8">

                <div class="flex items-center gap-4">

                    <!-- Avatar -->
                    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-blue-100 text-xl font-bold text-blue-600">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>

                    <div>

                        <h2 class="text-xl font-bold text-gray-900">
                            @Model.FullName
                        </h2>

                        <p class="mt-1 text-sm text-gray-500">
                            @Model.Email
                        </p>

                    </div>

                </div>

            </div>


            <!-- User Information -->
            <div class="px-6 py-6 sm:px-8">

                <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">

                    <!-- Full Name -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Full Name
                        </p>

                        <p class="mt-1 text-sm font-medium text-gray-900">
                            @Model.FullName
                        </p>

                    </div>


                    <!-- Email -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Email
                        </p>

                        <p class="mt-1 text-sm font-medium text-gray-900">
                            @Model.Email
                        </p>

                    </div>


                    <!-- Role -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Role
                        </p>

                        <div class="mt-2">

                            <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                                @Model.Role
                            </span>

                        </div>

                    </div>


                    <!-- Department -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Department
                        </p>

                        <p class="mt-1 text-sm font-medium text-gray-900">
                            @Model.Department
                        </p>

                    </div>


                    <!-- Salary -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Salary
                        </p>

                        <p class="mt-1 text-sm font-medium text-gray-900">
                            ₹@Model.Salary
                        </p>

                    </div>


                    <!-- Date of Joining -->
                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Date of Joining
                        </p>

                        <p class="mt-1 text-sm font-medium text-gray-900">
                            @Model.DateOfJoining.ToString("dd MMM yyyy")
                        </p>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="flex flex-col-reverse gap-3 border-t border-gray-100 px-6 py-5 sm:flex-row sm:justify-end sm:px-8">

                <a asp-action="Index"
                   class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 no-underline transition hover:bg-gray-50">
                    Back to Users
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white no-underline shadow-sm transition hover:bg-blue-700">
                    Edit User
                </a>

            </div>

        </div>

    </div>

</div>