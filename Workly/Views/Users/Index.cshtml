@model IEnumerable<Workly.Models.User>

@{
    ViewData["Title"] = "Users";
}

<div class="min-h-screen bg-gray-50 py-8">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Page Header -->
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    Users
                </h1>

                <p class="mt-1 text-sm text-gray-500">
                    Manage employees and their information
                </p>
            </div>

            <a asp-action="Create"
               class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">

                <span class="mr-2 text-lg">+</span>
                Add User

            </a>

        </div>

        <!-- Search -->
        <div class="mb-5 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">

            <form asp-action="Index"
                  method="get"
                  class="flex flex-col gap-3 lg:flex-row">

                <!-- Search Input -->
                <div class="relative flex-1">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search by name, email, role or department..."
                           class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 pl-10 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    <!-- Search Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="1.8"
                         stroke="currentColor"
                         class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="m21 21-4.35-4.35m0 0A7.5 7.5 0 1 0 6.04 6.04a7.5 7.5 0 0 0 10.61 10.61Z" />

                    </svg>

                </div>

                <!-- Sort -->
                <select name="sortOrder"
                        class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                    @if (string.IsNullOrEmpty(ViewBag.SortOrder))
                    {
                        <option value="" selected>Sort by Name</option>
                    }
                    else
                    {
                        <option value="">Sort by Name</option>
                    }

                    @if (ViewBag.SortOrder == "name_desc")
                    {
                        <option value="name_desc" selected>Name (Z-A)</option>
                    }
                    else
                    {
                        <option value="name_desc">Name (Z-A)</option>
                    }

                    @if (ViewBag.SortOrder == "salary_asc")
                    {
                        <option value="salary_asc" selected>Salary (Low to High)</option>
                    }
                    else
                    {
                        <option value="salary_asc">Salary (Low to High)</option>
                    }

                    @if (ViewBag.SortOrder == "salary_desc")
                    {
                        <option value="salary_desc" selected>Salary (High to Low)</option>
                    }
                    else
                    {
                        <option value="salary_desc">Salary (High to Low)</option>
                    }

                    @if (ViewBag.SortOrder == "date_asc")
                    {
                        <option value="date_asc" selected>Joining Date (Oldest)</option>
                    }
                    else
                    {
                        <option value="date_asc">Joining Date (Oldest)</option>
                    }

                    @if (ViewBag.SortOrder == "date_desc")
                    {
                        <option value="date_desc" selected>Joining Date (Newest)</option>
                    }
                    else
                    {
                        <option value="date_desc">Joining Date (Newest)</option>
                    }

                    @if (ViewBag.SortOrder == "role")
                    {
                        <option value="role" selected>Role</option>
                    }
                    else
                    {
                        <option value="role">Role</option>
                    }

                    @if (ViewBag.SortOrder == "department")
                    {
                        <option value="department" selected>Department</option>
                    }
                    else
                    {
                        <option value="department">Department</option>
                    }

                </select>

                <!-- Search Button -->
                <button type="submit"
                        class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">

                    Search

                </button>

                <!-- Clear -->
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search) ||
                     !string.IsNullOrWhiteSpace(ViewBag.SortOrder))
                {
                    <a asp-action="Index"
                       class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 no-underline transition hover:bg-gray-50">

                        Clear

                    </a>
                }

            </form>

        </div>

        <!-- User Count -->
        <!-- User Count -->
        <div class="mb-3 flex items-center justify-between">

            <p class="text-sm text-gray-500">

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                {
                    <span>
                        Showing
                        <span class="font-semibold text-gray-700">
                            @ViewBag.TotalUsers
                        </span>
                        user(s) for
                        "<span class="font-semibold text-gray-700">
                        @ViewBag.Search
                    </span>"
                </span>
            }
        else
            {
                <span>
                    <span class="font-semibold text-gray-700">
                        @ViewBag.TotalUsers
                    </span>
                    user(s) found
                </span>
            }

        </p>

    </div>

    <!-- Users Card -->
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="overflow-x-auto">

            <table class="min-w-full divide-y divide-gray-200">

                <!-- Table Header -->
                <thead class="bg-gray-50">

                    <tr>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Full Name
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Email
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Role
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Salary
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Department
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Date of Joining
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            Actions
                        </th>

                    </tr>

                </thead>


                <!-- Table Body -->
                <tbody class="divide-y divide-gray-100 bg-white">

                    @foreach (var item in Model)
                    {
                        <tr class="transition hover:bg-gray-50">

                            <!-- Full Name -->
                            <td class="whitespace-nowrap px-6 py-4">

                                <div class="font-semibold text-gray-900">
                                    @item.FullName
                                </div>

                            </td>


                            <!-- Email -->
                            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                                @item.Email
                            </td>


                            <!-- Role -->
                            <td class="whitespace-nowrap px-6 py-4">

                                <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                                    @item.Role
                                </span>

                            </td>


                            <!-- Salary -->
                            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-700">
                                ₹@item.Salary
                            </td>


                            <!-- Department -->
                            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                                @item.Department
                            </td>


                            <!-- Date -->
                            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                                @item.DateOfJoining.ToString("dd MMM yyyy")
                            </td>

                            <!-- Actions -->
                            <td class="whitespace-nowrap px-6 py-4">

                                <div class="flex items-center gap-2">

                                    <!-- Edit -->
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       title="Edit User"
                                       class="inline-flex items-center gap-1.5 rounded-md bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 transition hover:bg-amber-100">

                                        <!-- Edit Icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.8"
                                             stroke="currentColor"
                                             class="h-4 w-4">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 15.87a4.5 4.5 0 0 1-1.897 1.13L6 18l.999-2.685a4.5 4.5 0 0 1 1.13-1.897L16.862 4.487Z" />

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M19.5 7.125 16.875 4.5" />

                                        </svg>

                                        Edit
                                    </a>


                                    <!-- Details -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       title="View Details"
                                       class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:bg-gray-200">

                                        <!-- Eye Icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.8"
                                             stroke="currentColor"
                                             class="h-4 w-4">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M2.036 12.322a1.012 1.012 0 0 1 0-.644C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.01 9.964 7.178.07.21.07.438 0 .644C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.01-9.964-7.178Z" />

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />

                                        </svg>

                                        Details
                                    </a>


                                    <!-- Delete -->
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       title="Delete User"
                                       class="inline-flex items-center gap-1.5 rounded-md bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-100">

                                        <!-- Trash Icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke-width="1.8"
                                             stroke="currentColor"
                                             class="h-4 w-4">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21.75H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12.034.562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.532 0V4.5a2.25 2.25 0 0 0-2.25-2.25h-3a2.25 2.25 0 0 0-2.25 2.25v.528m7.532 0a48.7 48.7 0 0 0-7.532 0" />

                                        </svg>

                                        Delete
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="flex flex-col items-center justify-between gap-4 border-t border-gray-100 px-6 py-4 sm:flex-row">

                <!-- Page Information -->
                <p class="text-sm text-gray-500">
                    Page
                    <span class="font-semibold text-gray-700">
                        @ViewBag.CurrentPage
                    </span>
                    of
                    <span class="font-semibold text-gray-700">
                        @ViewBag.TotalPages
                    </span>
                </p>


                <!-- Pagination -->
                <div class="flex items-center gap-1">

                    <!-- Previous -->
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-sortOrder="@ViewBag.SortOrder"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 no-underline transition hover:bg-gray-50">

                            ← Previous

                        </a>
                    }
                    else
                    {
                        <span class="inline-flex cursor-not-allowed items-center rounded-lg border border-gray-200 bg-gray-100 px-3 py-2 text-sm font-medium text-gray-400">

                            ← Previous

                        </span>
                    }


                    <!-- Page Numbers -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                            <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-blue-600 px-3 text-sm font-semibold text-white">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.SortOrder"
                               asp-route-page="@i"
                               class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-gray-300 bg-white px-3 text-sm font-medium text-gray-700 no-underline transition hover:bg-gray-50">

                                @i

                            </a>
                        }
                    }


                    <!-- Next -->
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-sortOrder="@ViewBag.SortOrder"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 no-underline transition hover:bg-gray-50">

                            Next →

                        </a>
                    }
                    else
                    {
                        <span class="inline-flex cursor-not-allowed items-center rounded-lg border border-gray-200 bg-gray-100 px-3 py-2 text-sm font-medium text-gray-400">

                            Next →

                        </span>
                    }

                </div>

            </div>
        }

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="px-6 py-16 text-center">

                <h3 class="text-lg font-semibold text-gray-900">
                    No Users Found
                </h3>

                <p class="mt-2 text-sm text-gray-500">
                    There are currently no users in the system.
                </p>

                <a asp-action="Create"
                   class="mt-5 inline-flex rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                    Add Your First User
                </a>

            </div>
        }

    </div>

</div>

</div>