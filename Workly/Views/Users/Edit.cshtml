@model Workly.Models.UserFormViewModel
@* @model Workly.Models.User *@

@{
    ViewData["Title"] = "Edit User";
}

@{
    var isAdmin = User.IsInRole("Admin");
}

<div class="min-h-screen bg-gray-50 py-8">

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

        <!-- Page Header -->
        <div class="mb-6">

            <a asp-action="Index"
               class="mb-3 inline-flex items-center gap-2 text-sm font-medium text-gray-500 no-underline transition hover:text-blue-600">

                <span>←</span>
                Back to Users

            </a>

            <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                Edit User
            </h1>

            <p class="mt-1 text-sm text-gray-500">
                Update employee information
            </p>

        </div>


        <!-- Form Card -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                </div>


                <!-- Full Name -->
                <div class="mb-5">

                    <label asp-for="FullName"
                           class="mb-2 block text-sm font-semibold text-gray-700">
                    </label>

                    <input asp-for="FullName"
                           class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    <span asp-validation-for="FullName"
                          class="mt-1 block text-sm text-red-600">
                    </span>

                </div>


                <!-- Email -->
                <div class="mb-5">

                    <label asp-for="Email"
                           class="mb-2 block text-sm font-semibold text-gray-700">
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    <span asp-validation-for="Email"
                          class="mt-1 block text-sm text-red-600">
                    </span>

                </div>


                <!-- Password -->
                @if (isAdmin)
                {
                    <div class="mb-5">
                        <label asp-for="Password"
                               class="mb-2 block text-sm font-semibold text-gray-700">
                            New Password (Optional)
                        </label>

                        <input asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Leave blank to keep the current password"
                               class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                        <span asp-validation-for="Password"
                              class="mt-1 block text-sm text-red-600">
                        </span>
                    </div>
                }


                <!-- Role + Department -->
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                    <!-- Role -->
                    <div class="mb-5">

                        <label asp-for="Role"
                               class="mb-2 block text-sm font-semibold text-gray-700">
                        </label>

                        @if (isAdmin)
                        {
                            <select asp-for="Role"
                                    class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900">

                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="User">User</option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="mt-1 block text-sm text-red-600">
                            </span>
                        }
                        else
                        {
                            <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm text-gray-700">
                                @Model.Role
                            </p>

                            <input type="hidden" asp-for="Role" />
                        }

                    </div>


                    <!-- Department -->
                    <div class="mb-5">

                        <label asp-for="Department"
                               class="mb-2 block text-sm font-semibold text-gray-700">
                        </label>

                        @if (isAdmin)
                        {
                            <input asp-for="Department"
                                   class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900" />

                            <span asp-validation-for="Department"
                                  class="mt-1 block text-sm text-red-600">
                            </span>
                        }
                        else
                        {
                            <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm text-gray-700">
                                @Model.Department
                            </p>

                            <input type="hidden" asp-for="Department" />
                        }

                    </div>

                </div>


                <!-- Salary + Date -->
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                    <!-- Salary -->
                    <div class="mb-5">

                        <label asp-for="Salary"
                               class="mb-2 block text-sm font-semibold text-gray-700">
                        </label>
                        @if (isAdmin)
                        {
                            <input asp-for="Salary"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900" />

                            <span asp-validation-for="Salary"
                                  class="mt-1 block text-sm text-red-600">
                            </span>
                        }
                        else
                        {
                            <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm text-gray-700">
                                ₹@Model.Salary
                            </p>

                            <input type="hidden" asp-for="Salary" />
                        }

                    </div>


                    <!-- Date of Joining -->
                    <div class="mb-5">

                        <label asp-for="DateOfJoining"
                               class="mb-2 block text-sm font-semibold text-gray-700">
                        </label>

                        <input asp-for="DateOfJoining"
                               type="date"
                               class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                        <span asp-validation-for="DateOfJoining"
                              class="mt-1 block text-sm text-red-600">
                        </span>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-4 flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:justify-end">

                    <a asp-action="Index"
                       class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 no-underline transition hover:bg-gray-50">
                        Cancel
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}