@model Workly.Models.Attendance

@{
    ViewData["Title"] = "Record Attendance";
}

<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">

        <!-- Page Header -->
        <div class="mb-8">
            <a asp-controller="Attendance"
               asp-action="Index"
               class="text-sm font-medium text-indigo-600 hover:text-indigo-800">
                &larr; Back to Attendance
            </a>

            <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
                Record Attendance
            </h1>

            <p class="mt-2 text-sm text-gray-600">
                Record your attendance for today or a previous date.
            </p>
        </div>

        <!-- Attendance Form -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">

            <form asp-controller="Attendance"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="mb-5 text-sm text-red-600">
                </div>

                <!-- Attendance Date -->
                <div class="mb-6">
                    <label asp-for="AttendanceDate"
                           class="mb-2 block text-sm font-semibold text-gray-700">
                        Attendance Date
                    </label>

                    <input asp-for="AttendanceDate"
                           type="date"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />

                    <span asp-validation-for="AttendanceDate"
                          class="mt-2 block text-sm text-red-600">
                    </span>

                    <p class="mt-2 text-xs text-gray-500">
                        You can select today or a past date.
                    </p>
                </div>

                <!-- Attendance Status -->
                <div class="mb-6">
                    <label asp-for="Status"
                           class="mb-2 block text-sm font-semibold text-gray-700">
                        Attendance Status
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Workly.Models.AttendanceStatus>()"
                            class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                        <option value="">-- Select Status --</option>
                    </select>

                    <span asp-validation-for="Status"
                          class="mt-2 block text-sm text-red-600">
                    </span>
                </div>

                <!-- Notes -->
                <div class="mb-8">
                    <label asp-for="Notes"
                           class="mb-2 block text-sm font-semibold text-gray-700">
                        Notes <span class="font-normal text-gray-400">(Optional)</span>
                    </label>

                    <textarea asp-for="Notes"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter any additional notes..."
                              class="block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"></textarea>

                    <span asp-validation-for="Notes"
                          class="mt-2 block text-sm text-red-600">
                    </span>

                    <p class="mt-2 text-xs text-gray-500">
                        Maximum 500 characters.
                    </p>
                </div>

                <!-- Actions -->
                <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                    <a asp-controller="Attendance"
                       asp-action="Index"
                       class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                        Cancel
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                        Save Attendance
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}