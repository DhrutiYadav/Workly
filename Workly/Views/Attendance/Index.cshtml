@model IEnumerable<Workly.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">

        <!-- Page Header -->
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    Attendance Management
                </h1>
                <p class="mt-2 text-sm text-gray-600">
                    View attendance records and record your own attendance.
                </p>
            </div>

            <a asp-controller="Attendance"
               asp-action="Create"
               class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                + Record Attendance
            </a>
        </div>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"
                 role="alert">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Attendance Table -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <div class="border-b border-gray-200 px-6 py-5">
                <h2 class="text-lg font-semibold text-gray-900">
                    Attendance Records
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    @Model.Count() record(s) found
                </p>
            </div>

            @if (Model.Any())
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                @if (User.IsInRole("Admin") ||
                                     User.IsInRole("Manager"))
                                {
                                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                        Employee
                                    </th>
                                }

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Attendance Date
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Status
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Notes
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100 bg-white">
                            @foreach (var item in Model)
                            {
                                var statusClass = item.Status switch
                                {
                                    Workly.Models.AttendanceStatus.Present =>
                                        "bg-green-100 text-green-800",

                                    Workly.Models.AttendanceStatus.Absent =>
                                        "bg-red-100 text-red-800",

                                    Workly.Models.AttendanceStatus.HalfDay =>
                                        "bg-yellow-100 text-yellow-800",

                                    Workly.Models.AttendanceStatus.Leave =>
                                        "bg-blue-100 text-blue-800",

                                    _ => "bg-gray-100 text-gray-800"
                                };

                                <tr class="transition hover:bg-gray-50">

                                    @if (User.IsInRole("Admin") ||
                                         User.IsInRole("Manager"))
                                    {
                                        <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                                            @(item.Employee?.FullName ?? "Unknown")
                                        </td>
                                    }

                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">
                                        @item.AttendanceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="whitespace-nowrap px-6 py-4">
                                        <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @statusClass">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td class="max-w-xs px-6 py-4 text-sm text-gray-600">
                                        @(string.IsNullOrWhiteSpace(item.Notes)
                                            ? "—"
                                            : item.Notes)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-6 py-16 text-center">
                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-2xl">
                        📅
                    </div>

                    <h3 class="mt-4 text-lg font-semibold text-gray-900">
                        No attendance records yet
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Record your attendance to see it listed here.
                    </p>

                    <a asp-controller="Attendance"
                       asp-action="Create"
                       class="mt-6 inline-flex items-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700">
                        Record Your Attendance
                    </a>
                </div>
            }
        </div>

    </div>
</div>