@model IEnumerable<Workly.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">

        <!-- Page Header -->
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    Attendance Management
                </h1>
                <p class="mt-2 text-sm text-gray-600">
                    View attendance records and record your own attendance.
                </p>
            </div>

            <a asp-controller="Attendance"
               asp-action="Create"
               class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                + Record Attendance
            </a>
        </div>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"
                 role="alert">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Attendance Summary Cards -->
<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <!-- Present -->
    <div class="rounded-xl border border-green-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500">
                    Present
                </p>

                <p class="mt-2 text-3xl font-bold text-green-600">
                    @ViewBag.PresentCount
                </p>

                <p class="mt-1 text-xs text-gray-500">
                    Present records
                </p>
            </div>

            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-100 text-xl">
                ✓
            </div>
        </div>
    </div>

    <!-- Absent -->
    <div class="rounded-xl border border-red-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500">
                    Absent
                </p>

                <p class="mt-2 text-3xl font-bold text-red-600">
                    @ViewBag.AbsentCount
                </p>

                <p class="mt-1 text-xs text-gray-500">
                    Absent records
                </p>
            </div>

            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-xl">
                ✕
            </div>
        </div>
    </div>

    <!-- Half Day -->
    <div class="rounded-xl border border-yellow-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500">
                    Half Day
                </p>

                <p class="mt-2 text-3xl font-bold text-yellow-600">
                    @ViewBag.HalfDayCount
                </p>

                <p class="mt-1 text-xs text-gray-500">
                    Half-day records
                </p>
            </div>

            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-yellow-100 text-xl">
                ◐
            </div>
        </div>
    </div>

    <!-- Leave -->
    <div class="rounded-xl border border-blue-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-gray-500">
                    Leave
                </p>

                <p class="mt-2 text-3xl font-bold text-blue-600">
                    @ViewBag.LeaveCount
                </p>

                <p class="mt-1 text-xs text-gray-500">
                    Leave records
                </p>
            </div>

            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-xl">
                📅
            </div>
        </div>
    </div>

</div>

        <!-- Attendance Table -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <div class="border-b border-gray-200 px-6 py-5">



    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h2 class="text-lg font-semibold text-gray-900">
                Attendance Records
            </h2>

            <p class="mt-1 text-sm text-gray-500">
                @Model.Count() record(s) found
            </p>
        </div>

        <form asp-controller="Attendance"
              asp-action="Index"
              method="get"
              class="flex flex-col gap-3 sm:flex-row sm:items-end">

            <div>
                <label for="month"
                       class="mb-1 block text-sm font-medium text-gray-700">
                    Month
                </label>

                <select id="month"
                        name="month"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">

                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == (int)ViewBag.SelectedMonth)
                        {
                            <option value="@m" selected>
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                            </option>
                        }
                        else
                        {
                            <option value="@m">
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                            </option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="year"
                       class="mb-1 block text-sm font-medium text-gray-700">
                    Year
                </label>

                <select id="year"
                        name="year"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">

                    @for (int y = DateTime.Today.Year; y >= 2020; y--)
                    {
                        if (y == (int)ViewBag.SelectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }

                    @if ((int)ViewBag.SelectedYear < 2020)
                    {
                        <option value="@ViewBag.SelectedYear" selected>
                            @ViewBag.SelectedYear
                        </option>
                    }
                </select>
            </div>

            <button type="submit"
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
                Filter
            </button>

            <a asp-controller="Attendance"
               asp-action="Index"
               class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                Reset
            </a>
        </form>
    </div>
</div>

            @if (Model.Any())
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                @if (User.IsInRole("Admin") ||
                                     User.IsInRole("Manager"))
                                {
                                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                        Employee
                                    </th>
                                }

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Attendance Date
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Status
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                    Notes
                                </th>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                                        Actions
                                    </th>
                                }
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100 bg-white">
                            @foreach (var item in Model)
                            {
                                var statusClass = item.Status switch
                                {
                                    Workly.Models.AttendanceStatus.Present =>
                                        "bg-green-100 text-green-800",

                                    Workly.Models.AttendanceStatus.Absent =>
                                        "bg-red-100 text-red-800",

                                    Workly.Models.AttendanceStatus.HalfDay =>
                                        "bg-yellow-100 text-yellow-800",

                                    Workly.Models.AttendanceStatus.Leave =>
                                        "bg-blue-100 text-blue-800",

                                    _ => "bg-gray-100 text-gray-800"
                                };

                                <tr class="transition hover:bg-gray-50">

                                    @if (User.IsInRole("Admin") ||
                                         User.IsInRole("Manager"))
                                    {
                                        <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                                            @(item.Employee?.FullName ?? "Unknown")
                                        </td>
                                    }

                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">
                                        @item.AttendanceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="whitespace-nowrap px-6 py-4">
                                        <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @statusClass">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td class="max-w-xs px-6 py-4 text-sm text-gray-600">
                                        @(string.IsNullOrWhiteSpace(item.Notes)
                                            ? "—"
                                            : item.Notes)
                                    </td>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        <td class="whitespace-nowrap px-6 py-4">
                                            <div class="flex items-center gap-2">
                                                <a asp-controller="Attendance"
                                                   asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="inline-flex items-center rounded-lg bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">
                                                    Details
                                                </a>

                                                <a asp-controller="Attendance"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="inline-flex items-center rounded-lg bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100">
                                                    Edit
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-6 py-16 text-center">
                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-2xl">
                        📅
                    </div>

                    <h3 class="mt-4 text-lg font-semibold text-gray-900">
                        No attendance records yet
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Record your attendance to see it listed here.
                    </p>

                    <a asp-controller="Attendance"
                       asp-action="Create"
                       class="mt-6 inline-flex items-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700">
                        Record Your Attendance
                    </a>
                </div>
            }
        </div>

    </div>
</div>