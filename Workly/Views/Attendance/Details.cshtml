@model Workly.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";

    var statusStyle = Model.Status switch
    {
        Workly.Models.AttendanceStatus.Present =>
            "bg-green-100 text-green-800",

        Workly.Models.AttendanceStatus.Absent =>
            "bg-red-100 text-red-800",

        Workly.Models.AttendanceStatus.HalfDay =>
            "bg-yellow-100 text-yellow-800",

        Workly.Models.AttendanceStatus.Leave =>
            "bg-blue-100 text-blue-800",

        _ => "bg-gray-100 text-gray-800"
    };
}

<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">

        <!-- Page Header -->
        <div class="mb-8">
            <a asp-controller="Attendance"
               asp-action="Index"
               class="text-sm font-medium text-indigo-600 hover:text-indigo-800">
                &larr; Back to Attendance
            </a>

            <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
                Attendance Details
            </h1>

            <p class="mt-2 text-sm text-gray-600">
                View the complete information for this attendance record.
            </p>
        </div>

        <!-- Details Card -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <!-- Card Header -->
            <div class="border-b border-gray-200 bg-gray-50 px-6 py-5">
                <h2 class="text-lg font-semibold text-gray-900">
                    Record Information
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    Attendance ID: #@Model.Id
                </p>
            </div>

            <!-- Card Body -->
            <div class="divide-y divide-gray-100 px-6">

                <!-- Employee -->
                <div class="py-5">
                    <p class="text-sm font-medium text-gray-500">
                        Employee Name
                    </p>

                    <p class="mt-2 text-base font-semibold text-gray-900">
                        @(Model.Employee?.FullName ?? "Unknown")
                    </p>
                </div>

                <!-- Employee ID -->
                <div class="py-5">
                    <p class="text-sm font-medium text-gray-500">
                        Employee ID
                    </p>

                    <p class="mt-2 text-base text-gray-900">
                        @Model.EmployeeId
                    </p>
                </div>

                <!-- Attendance Date -->
                <div class="py-5">
                    <p class="text-sm font-medium text-gray-500">
                        Attendance Date
                    </p>

                    <p class="mt-2 text-base text-gray-900">
                        @Model.AttendanceDate.ToString("dd MMMM yyyy")
                    </p>
                </div>

                <!-- Attendance Status -->
                <div class="py-5">
                    <p class="text-sm font-medium text-gray-500">
                        Attendance Status
                    </p>

                    <div class="mt-3">
                        <span class="inline-flex rounded-full px-4 py-2 text-sm font-semibold @statusStyle">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <!-- Notes -->
                <div class="py-5">
                    <p class="text-sm font-medium text-gray-500">
                        Notes
                    </p>

                    <p class="mt-2 whitespace-pre-wrap break-words text-base text-gray-700">
                        @(string.IsNullOrWhiteSpace(Model.Notes)
                            ? "No notes available."
                            : Model.Notes)
                    </p>
                </div>

            </div>

            <!-- Card Footer -->
            <div class="flex flex-col-reverse gap-3 border-t border-gray-200 bg-gray-50 px-6 py-5 sm:flex-row sm:justify-end">

                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">
                    Back to Attendance
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-controller="Attendance"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700">
                        Edit Attendance
                    </a>
                }

            </div>

        </div>
    </div>
</div>