@* namespace Workly.Views.Account *@

@* {
    public class Login
    {
    }
} *@

@model Workly.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="flex min-h-[75vh] items-center justify-center px-4 py-12">

    <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-lg">

        <div class="mb-8 text-center">

            <h1 class="text-3xl font-bold text-gray-900">
                Welcome to Workly
            </h1>

            <p class="mt-2 text-sm text-gray-500">
                Sign in to your account
            </p>

        </div>

        <form asp-controller="Account"
              asp-action="Login"
              asp-route-returnUrl="@ViewData["ReturnUrl"]"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="mb-5 text-sm text-red-600">
            </div>

            <div class="mb-5">

                <label asp-for="Email"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       autocomplete="username"
                       class="block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                       placeholder="Enter your email" />

                <span asp-validation-for="Email"
                      class="mt-1 block text-sm text-red-600">
                </span>

            </div>

            <div class="mb-5">

                <label asp-for="Password"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       autocomplete="current-password"
                       class="block w-full rounded-lg border border-gray-300 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                       placeholder="Enter your password" />

                <span asp-validation-for="Password"
                      class="mt-1 block text-sm text-red-600">
                </span>

            </div>

            <div class="mb-6 flex items-center gap-2">

                <input asp-for="RememberMe"
                       class="h-4 w-4 rounded border-gray-300" />

                <label asp-for="RememberMe"
                       class="text-sm text-gray-600">
                    Remember me
                </label>

            </div>

            <button type="submit"
                    class="w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Sign In
            </button>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
